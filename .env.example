VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Stripe — VITE_STRIPE_PUBLISHABLE_KEY es pública (viaja al navegador por
# diseño, mismo criterio que VITE_SUPABASE_ANON_KEY). Las demás son SOLO de
# servidor (api/) — nunca deben llevar prefijo VITE_ ni exponerse al cliente.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
