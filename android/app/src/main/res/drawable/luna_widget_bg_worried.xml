<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de Luna, estado "worried" (degradado 135° como LunaStrip.module.css).
     Colores en values/colors.xml (+ values-night para el tema oscuro). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/luna_danger_soft"
        android:endColor="@color/luna_danger_border" />
    <corners android:radius="24dp" />
</shape>
