         Este archivo (values/) es el español; values-en/ trae el inglés.
         El widget sigue el idioma del TELÉFONO (no el que se elija dentro de la app). -->
    <string name="luna_widget_label">LunaPay</string>
    <string name="luna_widget_description">Luna te muestra el estado de tus pagos de un vistazo</string>

    <string name="luna_when_today">hoy</string>
    <string name="luna_when_tomorrow">mañana</string>
    <plurals name="luna_when_in_days">
        <item quantity="one">en %d día</item>
        <item quantity="other">en %d días</item>
    </plurals>
    <string name="luna_next_payment">Próximo: %1$s, %2$s</string>
    <string name="luna_progress">%1$d de %2$d pagos</string>

    <string name="luna_happy_title">¡Vas al corriente!</string>
    <string name="luna_attentive_title_today">Hoy vence %1$s</string>
    <string name="luna_attentive_title_tomorrow">Mañana vence %1$s</string>
    <plurals name="luna_attentive_sub_more">
        <item quantity="one">Y %d pago más esta semana</item>
        <item quantity="other">Y %d pagos más esta semana</item>
    </plurals>
    <string name="luna_attentive_sub_none">Luna vigila tus pagos</string>
