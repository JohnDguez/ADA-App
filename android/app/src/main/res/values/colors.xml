<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Color de acento de LunaPay (variable CSS "accent" en light mode,
         src/index.css) — usado por Android para tintar el ícono de las
         notificaciones push (la silueta blanca de ic_stat_notification.xml)
         en la barra de estado y el área expandida de la notificación. -->
    <color name="notification_accent">#2F8CFA</color>
    <!-- Widget de Luna (tema claro). Espejo de las variables CSS de src/index.css. Los grises "idle" (telarañas / salió a pasear) solo existen en el widget. -->
    <color name="luna_text">#020A1F</color>
    <color name="luna_ring_bg">#FFFFFF</color>
    <color name="luna_ring_track">#E4E2DC</color>
    <color name="luna_ring">#2F8CFA</color>
    <color name="luna_ring_danger">#E82E47</color>
    <color name="luna_ring_idle">#696969</color>
    <color name="luna_accent_soft">#E8F2FF</color>
    <color name="luna_accent_border">#B3D4FD</color>
    <color name="luna_paid_soft">#E6FBEC</color>
    <color name="luna_paid_border">#A0EDB8</color>
    <color name="luna_warning_soft">#FEF6E0</color>
    <color name="luna_warning_border">#FAD98A</color>
    <color name="luna_danger_soft">#FDEAED</color>
    <color name="luna_danger_border">#F5B3BC</color>
    <color name="luna_idle_1">#F2F2F2</color>
    <color name="luna_idle_2">#E4E2DC</color>
    <color name="luna_idle_3">#CFCBC0</color>
    <!-- Estado "dormida": oscuro en ambos temas a propósito (variables luna-night-* de index.css) -->
    <color name="luna_night_1">#0F1117</color>
    <color name="luna_night_2">#1A2B40</color>
    <color name="luna_night_3">#1E3A5C</color>
    <color name="luna_night_text">#E8EAF0</color>
    <color name="luna_night_surface">#1A1D27</color>
    <color name="luna_night_track">#2A2D3A</color>
    <color name="luna_night_accent">#3B9EFF</color>
</resources>
