<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Ícono y color por default para las notificaciones de Firebase Cloud
             Messaging (silueta blanca requerida por Android — ver
             res/drawable/ic_stat_notification.xml). Sin esto, FCM cae al ícono
             por default del sistema en la barra de estado. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (FCM) — OBLIGATORIO desde Android 13 (API 33):
         sin esta declaración en el manifest, PushNotifications.requestPermissions()
         del lado de JS (ver usePushNotifications.js → subscribeNative()) ni
         siquiera puede mostrar el diálogo del sistema — Android solo permite
         pedir en tiempo de ejecución un permiso que la app ya declaró aquí;
         sin la declaración, la petición regresa denegada de inmediato, sin
         diálogo, y la app queda sin poder mostrar notificaciones aunque el
         token de FCM se registre bien. targetSdkVersion de este proyecto es
         36 (ver android/variables.gradle), muy por encima del mínimo (33)
         donde este permiso se volvió obligatorio. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
